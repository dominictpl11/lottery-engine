# 复制为 .env 后按需修改。.env 含密码，禁止提交（NFR-5）。
#   cp .env.example .env

# --- docker compose 使用 ---
MYSQL_ROOT_PASSWORD=[REDACTED_LOCAL_CREDENTIAL]
MYSQL_DATABASE=lottery_db
MYSQL_USER=lottery
MYSQL_PASSWORD=[REDACTED_LOCAL_CREDENTIAL]
MYSQL_HOST_PORT=3307
REDIS_HOST_PORT=6379

# --- 应用使用 ---
# 端口须与上面的 MYSQL_HOST_PORT 一致。
DATABASE_URL=mysql+pymysql://lottery:[REDACTED_LOCAL_CREDENTIAL]@127.0.0.1:3307/lottery_db?charset=utf8mb4
REDIS_URL=redis://127.0.0.1:6379/0

# FR-6a 频率限流：窗口秒数与窗口内最大请求数。
RATE_LIMIT_WINDOW_SECONDS=10
RATE_LIMIT_MAX_COUNT=3

# FR-5 幂等：处理中占位的存活时间 / 首次结果的可回放时长（秒）。
IDEMPOTENCY_LOCK_TTL_SECONDS=60
IDEMPOTENCY_RESULT_TTL_SECONDS=86400
